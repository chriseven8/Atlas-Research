# All credentials stay on the backend. CN/US public daily prices need no keys.
# Optional: US news and macro feeds only.
ALPHA_VANTAGE_API_KEY=
OPENAI_API_KEY=
# Set a model available in your API account before enabling AI synthesis.
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
# Optional: sqlite is the local default. Docker configures PostgreSQL.
# DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research
EMBED_WORKER=true
# 这几个值是一组，改一个要连带检查其余几个，理由见 settings.py 的注释。
# HTTP 超时放宽后单次调用更不容易被截断，但整条链路的墙钟时间也随之变长，
# 所以 TASK_TIMEOUT_SECONDS 必须跟着放宽，否则会从「单次截断」变成「整个任务被砍」。
HTTP_TIMEOUT_SECONDS=60
TASK_TIMEOUT_SECONDS=600
# 多 Agent 一轮要多次调用模型（规划/各角色/返工/仲裁/报告），故预算按一次完整跑量给。
# 这里显式赋值会覆盖 settings.py 的代码默认值，改代码默认值时请同步这一行。
MAX_LLM_OUTPUT_TOKENS=16000
MAX_LLM_CALLS=16
# Optional prices, USD per million tokens. Empty = cost unavailable, not free.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

